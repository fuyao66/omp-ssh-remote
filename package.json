{
  "name": "omp-ssh-remote-workspace",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Oh My Pi SSH remote workspace plugin",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:omp": "bun scripts/build.ts omp",
    "build:worker:arm64": "bun scripts/compile-worker.ts arm64",
    "build:worker:x64": "bun scripts/compile-worker.ts x64",
    "build:worker:all": "bun scripts/compile-worker.ts arm64 && bun scripts/compile-worker.ts x64",
    "benchmark:omp": "bun scripts/benchmark-remote.ts omp",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run build && bun test"
  },
  "dependencies": {
    "@oh-my-pi/omptype": "18.3.4",
    "@oh-my-pi/pi-agent-core": "18.3.4",
    "@oh-my-pi/pi-coding-agent": "18.3.4",
    "@oh-my-pi/pi-tui": "18.3.4",
    "@oh-my-pi/pi-utils": "18.3.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.8.0"
  }
}
