{
  "name": "omp-ssh-remote-workspace",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Development workspace for independent OMP SSH Remote and Pi SSH Remote plugins",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun scripts/build.ts all",
    "build:omp": "bun scripts/build.ts omp",
    "build:pi": "bun scripts/build.ts pi",
    "build:worker:arm64": "bun scripts/compile-worker.ts arm64",
    "build:worker:x64": "bun scripts/compile-worker.ts x64",
    "build:worker:all": "bun scripts/compile-worker.ts arm64 && bun scripts/compile-worker.ts x64",
    "build:pi-worker:arm64": "bun scripts/compile-pi-worker.ts arm64",
    "build:pi-worker:x64": "bun scripts/compile-pi-worker.ts x64",
    "build:pi-worker:all": "bun scripts/compile-pi-worker.ts arm64 && bun scripts/compile-pi-worker.ts x64",
    "benchmark:omp": "bun scripts/benchmark-remote.ts omp",
    "benchmark:pi": "bun scripts/benchmark-remote.ts pi",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run build && bun test"
  },
  "dependencies": {
    "@cortexkit/aft-pi": "0.51.2",
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@oh-my-pi/omptype": "17.3.3",
    "@oh-my-pi/pi-agent-core": "17.3.3",
    "@oh-my-pi/pi-coding-agent": "17.3.3",
    "@oh-my-pi/pi-utils": "17.3.3",
    "diff": "8.0.4",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.8.0"
  }
}
